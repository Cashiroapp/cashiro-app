rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================
    // CASHIRO PERSONAL — REGLAS VIGENTES DE PRODUCCIÓN
    // Conservan el acceso del usuario a su documento y subcolecciones.
    // ============================================================
    match /usuarios/{userId} {
      allow read, write: if request.auth != null
                         && request.auth.uid == userId;

      match /{document=**} {
        allow read, write: if request.auth != null
                           && request.auth.uid == userId;
      }
    }

    // ============================================================
    // CASHIRO INVERSIONES — FASE 1.2
    // Acceso de solo lectura, limitado por proveedor y membresía.
    // ============================================================
    function isGoogleAuthenticated() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'google.com';
    }

    function membershipPath(spaceId, uid) {
      return /databases/$(database)/documents/investmentSpaces/$(spaceId)/members/$(uid);
    }

    function hasExpectedMembershipSchema(membership) {
      return membership.keys().hasAll([
          'displayName',
          'email',
          'roles',
          'status'
        ])
        && membership.keys().hasOnly([
          'displayName',
          'email',
          'roles',
          'status',
          'createdAt',
          'createdBy',
          'updatedAt',
          'updatedBy'
        ])
        && membership.displayName is string
        && membership.email is string
        && membership.status is string
        && membership.roles is list
        && membership.roles.size() > 0
        && membership.roles.size() <= 3
        && membership.roles.hasOnly(['admin', 'investor', 'manager']);
    }

    function hasValidActiveMembership(spaceId) {
      return isGoogleAuthenticated()
        && exists(membershipPath(spaceId, request.auth.uid))
        && hasExpectedMembershipSchema(
          get(membershipPath(spaceId, request.auth.uid)).data
        )
        && get(membershipPath(spaceId, request.auth.uid)).data.status == 'active';
    }

    function hasRole(spaceId, role) {
      return hasValidActiveMembership(spaceId)
        && role in get(membershipPath(spaceId, request.auth.uid)).data.roles;
    }

    match /investmentSpaces/{spaceId} {
      // No se permite enumerar, crear, modificar ni eliminar espacios.
      allow get: if hasValidActiveMembership(spaceId);
      allow list, create, update, delete: if false;

      match /members/{memberId} {
        // Cada usuario autenticado con Google puede consultar su membresía.
        allow get: if isGoogleAuthenticated()
          && request.auth.uid == memberId;

        // Solo un admin con membresía activa y válida puede listar miembros.
        allow list: if hasRole(spaceId, 'admin');

        // La administración de miembros no está habilitada en la Fase 1.
        allow create, update, delete: if false;
      }

      // Colecciones de fases futuras: acceso completamente bloqueado.
      match /investments/{document=**} {
        allow read, write: if false;
      }

      match /clients/{document=**} {
        allow read, write: if false;
      }

      match /assets/{document=**} {
        allow read, write: if false;
      }

      match /periods/{document=**} {
        allow read, write: if false;
      }

      match /transactions/{document=**} {
        allow read, write: if false;
      }

      match /investorPayments/{document=**} {
        allow read, write: if false;
      }

      match /supports/{document=**} {
        allow read, write: if false;
      }

      match /supportLinks/{document=**} {
        allow read, write: if false;
      }

      match /auditEvents/{document=**} {
        allow read, write: if false;
      }

      // Catch-all exclusivo de Inversiones. No afecta otras colecciones.
      match /{document=**} {
        allow read, write: if false;
      }
    }
  }
}
